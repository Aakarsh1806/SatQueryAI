# Copy to .env (ignored). Shell environment wins over .env. Never commit secrets.
# Local SQLite default. Compose uses its separate DOCKER_DATABASE_URL below.
DATABASE_URL=sqlite:///./satquery.db
DOCKER_DATABASE_URL=sqlite:////var/lib/satquery/satquery.db
# Local PostgreSQL (replace password with a URL-encoded local secret):
# DATABASE_URL=postgresql+psycopg://satquery:REPLACE_ME@localhost:5432/satquery
# Docker PostgreSQL: set DOCKER_DATABASE_URL to the same URL but host=postgres.
SATQUERY_MAX_UPLOAD_BYTES=20971520
SATQUERY_MAX_REQUEST_BYTES=42991616
SATQUERY_RETENTION_DAYS=1
SATQUERY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
SATQUERY_DEVICE=auto
SATQUERY_MODELS_CONFIG=backend/models.yaml
SATQUERY_RS_VLM_WEIGHTS_PATH=weights/satquery_rsvlm_lora
SATQUERY_GROUNDING_WEIGHTS_PATH=weights/SatQuery_Model2_Handover
SATQUERY_CHANGE_WEIGHTS_PATH=weights/chg2cap_3h/run_01/best.pth
SATQUERY_FUSION_WEIGHTS_PATH=weights/SatQuery_Model4_Handover/model
# Optional mode overrides: SATQUERY_RS_VLM_MODE=real (restart after changes).
# Model 4 real mode is enabled but unverified on real pairs; use stub for synthetic output.
DEMO_MODE=false
DEMO_MANIFEST=demo/manifest.json
# Set only to serve npm run build output from FastAPI instead of Vite/nginx:
# SATQUERY_STATIC_DIR=frontend/dist
# Compose host paths; never put actual credentials in this example.
WEIGHTS_DIR=./weights
MODELS_CONFIG_FILE=./backend/models.yaml
DEMO_DIR=./demo
POSTGRES_PASSWORD_FILE=./.secrets/postgres_password
POSTGRES_PORT=5432
INSTALL_ML=false
